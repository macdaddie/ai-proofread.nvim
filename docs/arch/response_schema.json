{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://ai-proofread.nvim/response/v5",
  "title": "AI Proofread Response Schema",
  "description": "Response contract for ai-proofread.nvim findings",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["correction", "rewrite"]
          },
          "category": {
            "type": "string",
            "enum": [
              "spelling",
              "grammar",
              "punctuation",
              "long_sentence"
            ]
          },
          "original": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24000
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": ["type", "category", "original", "suggestion", "message"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    }
  },
  "required": ["findings"],
  "additionalProperties": false
}
